   background: linear-gradient(135deg, var(--pink), #e84393);
@@ -1469,6 +1473,11 @@ html.dark .similar-img { background: rgba(255,255,255,.08); }
   position: absolute; top: 50%; left: 50%;
   font-size: .72rem; font-weight: 800; color: #fff; white-space: nowrap;
   text-shadow: 0 1px 3px rgba(0,0,0,.4);
+  display: flex; flex-direction: column; align-items: center; line-height: 1.2;
+}
+.wheel-seg-code {
+  font-style: normal; font-size: .55rem; font-weight: 700;
+  opacity: .92; letter-spacing: .3px; margin-top: 2px;
 }
 .wheel-hub {
